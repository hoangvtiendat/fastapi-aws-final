# --- Database Configuration (PostgreSQL / RDS) ---
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fastapi_prod

DB_USER=postgres
DB_PASSWORD=Tiendat2004
DB_HOST=fastapi-db.cn0ee24g0uba.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
